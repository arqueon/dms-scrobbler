{
	"id": "lastfmScrobbler",
	"name": "Last.fm Scrobbler",
	"description": "Scrobble MPRIS music tracks to Last.fm and love/unlove tracks from the bar and IPC",
	"version": "1.0.0",
	"author": "arqueon",
	"icon": "favorite",
	"components": {
